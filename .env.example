# Copy this file to .env.local (git-ignored) and fill in the values you have. Expo inlines
# EXPO_PUBLIC_* variables at build time; for EAS builds add them as environment variables of the
# EAS project. Leave a value empty to switch that part off.

# RevenueCat — https://app.revenuecat.com → Project → API keys.
# Public SDK keys of the App Store (appl_…) and Google Play (goog_…) apps — development/store builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Test Store key (test_…) — used in Expo Go and on the web, where the native stores are unavailable.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Entitlement that unlocks Pro (default: "pro").
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro

# Legal links shown on the paywall and in Settings.
# Empty terms → Apple's standard EULA on iOS (hidden elsewhere); empty privacy → the in-app screen.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# AI coach (ChatGPT). URL of your deployed server/ai-coach Worker; empty = AI analysis is off and
# entries stay on the phone. The token is not a secret (it ships in the app); it only filters casual
# traffic. The OpenAI API key goes into the Worker's secrets, never here.
EXPO_PUBLIC_AI_URL=
EXPO_PUBLIC_AI_TOKEN=
