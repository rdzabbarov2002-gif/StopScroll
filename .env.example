# RevenueCat — https://app.revenuecat.com → Project → API keys.
# Copy this file to .env.local (git-ignored) and fill in the values. Expo inlines EXPO_PUBLIC_*
# variables at build time; for EAS builds add them as environment variables in the EAS project.

# Public SDK keys of the App Store and Google Play apps (used in development/store builds).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Test Store key — used in Expo Go and on the web, where the native stores are unavailable.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxx

# Entitlement that unlocks Pro (default: "pro").
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
